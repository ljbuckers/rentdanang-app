{
  "name": "rentdanang",
  "version": "0.1.0",
  "private": true,
  "description": "Rental listing aggregation platform for Da Nang, Vietnam",
  "scripts": {
    "dev": "pnpm --filter @rentdanang/web dev",
    "build": "pnpm --filter @rentdanang/web build",
    "start": "pnpm --filter @rentdanang/web start",
    "test": "pnpm --filter @rentdanang/web test",
    "db:migrate": "cd database && bash migrate.sh",
    "db:seed": "cd database && bash seed.sh",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "playwright": "1.58.2"
  },
  "devDependencies": {
    "@turf/helpers": "^7.3.4",
    "@turf/simplify": "^7.3.4",
    "@turf/union": "^7.3.4",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
