# =============================================================
# RentDaNang Environment Variables
# Copy to .env and fill in values
# =============================================================

# Database
DATABASE_URL=postgresql://rentdanang:rentdanang_dev@localhost:5432/rentdanang
POSTGRES_PASSWORD=rentdanang_dev
REDIS_URL=redis://localhost:6379

# APIs
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=
ANTHROPIC_API_KEY=

# Scraping - Bright Data
BRIGHT_DATA_TOKEN=
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# Storage - Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=rentdanang-images
R2_PUBLIC_URL=

# Auth - NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Auth - Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Alerts
RESEND_API_KEY=

# SMS & WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# App
NODE_ENV=development
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Currency
VND_USD_RATE=25500

# Affiliate Programs
NEXT_PUBLIC_TRAVELPAYOUTS_ID=
NEXT_PUBLIC_STAY22_ID=
NEXT_PUBLIC_WISE_REFERRAL=
NEXT_PUBLIC_SAFETYWING_REFERRAL=
NEXT_PUBLIC_12GO_AFFILIATE=
